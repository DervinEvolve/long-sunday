{
  "about": [
    "How drawn surfaces become built ones. Tune by hand, then run npm run real:bake.",
    "rules run top to bottom and the first that fits wins. A rule tests one part (one add() of the ink builder),",
    "or one triangle on the meshes named in perFace. Tests: hue [from, to] in degrees (may wrap), sat, val,",
    "near [colours..., distance in 0-255 rgb], flat, hatch, dither, sway, letter, noedge, squashed, planar,",
    "up / down / side (share of the area facing that way), size (box diagonal, m), wide, thin, dx dy dz,",
    "y and top (lowest and highest point above the district pad), area (m2), tris, gradient, mesh, chunk.",
    "materials: texture is a set in the library (tools/real/textures.json) or null for a plain surface.",
    "size is metres per repeat. tint is how much the drawn colour shows through (luma keeps only its lightness),",
    "measured against ref. plain surfaces share one browser material and take their colour from the drawing.",
    "reflect is how strongly the sky shows in a surface (envMapIntensity). Rough outdoor surfaces keep it low, because the browser cannot tell a lawn under trees from a lawn under open sky."
  ],

  "perFace": ["terrain/ground-*", "terrain/cliff", "terrain/underside"],
  "plain": {"reflect": 0.8},

  "materials": {
    "shadow":   {"kind": "drop"},
    "lettering":{"kind": "lettering", "texture": null, "albedo": 1.0, "lightmap": 1.0},
    "marble":   {"texture": "marble", "size": 2.4, "tint": 0.55, "tintMode": "luma", "ref": "#f5f0e8", "tintClamp": [0.55, 1.0], "fallback": "paving", "bevel": 0.025, "reflect": 0.5},
    "ashlar":   {"texture": "ashlar", "size": 3.0, "tint": 0.5, "tintMode": "luma", "ref": "#f5f0e8", "tintClamp": [0.55, 1.0], "fallback": "marble", "bevel": 0.03, "reflect": 0.25},
    "cladding": {"texture": "marble", "size": 3.6, "tint": 0.9, "tintMode": "rgb", "ref": "#f5f0e8", "tintClamp": [0.3, 1.0], "fallback": "paint", "reflect": 0.3},
    "paving":   {"texture": "paving", "size": 2.5, "tint": 0.5, "tintMode": "luma", "ref": "#ece4d6", "tintClamp": [0.5, 1.0], "fallback": "concrete", "reflect": 0.4},
    "concrete": {"texture": "concrete", "size": 3.0, "tint": 0.6, "tintMode": "luma", "ref": "#ece4d6", "tintClamp": [0.4, 1.0], "fallback": "paving", "reflect": 0.35},
    "asphalt":  {"texture": "asphalt", "size": 3.0, "tint": 0.4, "tintMode": "luma", "ref": "#6d6796", "tintClamp": [0.6, 1.0], "fallback": "paving", "reflect": 0.4},
    "brick":    {"texture": "brick", "size": 1.6, "tint": 0.7, "tintMode": "rgb", "ref": "#d98a5f", "tintClamp": [0.3, 1.0], "fallback": "paint", "reflect": 0.25},
    "rock":     {"texture": "rock", "size": 6.0, "tint": 0.55, "tintMode": "rgb", "ref": "#e58f74", "tintClamp": [0.4, 1.0], "fallback": "soil", "lightmap": 0.2, "reflect": 0.25},
    "soil":     {"texture": "soil", "size": 2.5, "tint": 0.5, "tintMode": "rgb", "ref": "#f0c9a2", "tintClamp": [0.4, 1.0], "fallback": "grass", "reflect": 0.25},
    "grass":    {"texture": "grass", "size": 3.5, "tint": 0.55, "tintMode": "rgb", "ref": "#8cc56c", "tintClamp": [0.45, 1.0], "vary": 0.3, "varyScale": 9.0, "fallback": "soil", "reflect": 0.25},
    "bark":     {"texture": "bark", "size": 1.2, "tint": 0.4, "tintMode": "luma", "ref": "#8a5a3c", "tintClamp": [0.5, 1.0], "fallback": "wood", "reflect": 0.25},
    "wood":     {"texture": "wood", "size": 1.5, "tint": 0.6, "tintMode": "rgb", "ref": "#c98a55", "tintClamp": [0.4, 1.0], "fallback": "paint", "reflect": 0.4},
    "leaves":   {"kind": "foliage", "cardMaterial": "leafcards", "coreMaterial": "leafcore", "cards": 1.7, "cardsMin": 6, "cardsMax": 70, "cardSize": 0.8, "cardSizeMin": 0.45, "cardSizeMax": 2.0, "core": 0.72},
    "hedge":    {"kind": "foliage", "cardMaterial": "leafcards", "coreMaterial": "leafcore", "cards": 3.0, "cardsMin": 5, "cardsMax": 40, "cardSize": 0.9, "cardSizeMin": 0.3, "cardSizeMax": 0.9, "core": 0.85},
    "leafcards":{"kind": "cards", "texture": "leaves", "atlas": [2, 2], "tint": 0.35, "tintMode": "luma", "ref": "#8cc56c", "tintClamp": [0.6, 1.0], "alphaTest": 0.45, "doubleSided": true, "reflect": 0.2, "roughness": 0.7},
    "leafcore": {"plain": true, "roughness": 1.0, "metalness": 0.0, "albedo": 0.42},
    "paint":    {"plain": true, "roughness": 0.55, "metalness": 0.0, "albedo": 0.8},
    "cloth":    {"plain": true, "roughness": 0.95, "metalness": 0.0, "albedo": 0.8},
    "steel":    {"plain": true, "roughness": 0.38, "metalness": 1.0, "albedo": 0.75},
    "brass":    {"plain": true, "roughness": 0.32, "metalness": 1.0, "albedo": 0.95, "bevel": 0.01},
    "patina":   {"plain": true, "roughness": 0.8, "metalness": 0.0, "albedo": 0.7},
    "window":   {"plain": true, "roughness": 0.05, "metalness": 0.0, "albedo": 0.12},
    "water":    {"plain": true, "roughness": 0.04, "metalness": 0.6, "albedo": 0.6},
    "lamp":     {"plain": true, "kind": "lamp", "roughness": 0.4, "metalness": 0.0, "albedo": 1.0, "glow": 30.0},
    "glass":    {"kind": "glass", "texture": null, "albedo": 0.9, "opacity": 0.38, "roughness": 0.05, "metalness": 0.85}
  },

  "rules": [
    { "name": "letters",             "when": {"letter": true}, "material": "lettering" },
    { "name": "drawn shadows",       "when": {"squashed": true, "noedge": true, "flat": [0.9, null]}, "material": "shadow" },
    { "name": "see-through",         "when": {"dither": [null, 0.98]}, "material": "glass" },
    { "name": "terrain rock",        "when": {"mesh": ["terrain/cliff", "terrain/underside"]}, "material": "rock" },
    { "name": "terrain grass",       "when": {"mesh": "terrain/ground-*", "hue": [70, 170], "sat": [0.18, null]}, "material": "grass" },
    { "name": "terrain bare rock",   "when": {"mesh": "terrain/ground-*", "hue": [0, 22], "sat": [0.3, null]}, "material": "rock" },
    { "name": "terrain pads",        "when": {"mesh": "terrain/ground-*", "sat": [null, 0.14], "val": [0.7, null]}, "material": "paving" },
    { "name": "terrain bare ground", "when": {"mesh": "terrain/ground-*"}, "material": "soil" },
    { "name": "road surface",        "when": {"mesh": "terrain/streets", "near": ["#6d6796", 40]}, "material": "asphalt" },
    { "name": "leaves in the wind",  "when": {"sway": true, "hue": [65, 175], "sat": [0.15, null], "tris": [12, null]}, "material": "leaves" },
    { "name": "brown trunks",        "when": {"sway": true, "hue": [8, 45], "sat": [0.25, 0.8], "val": [0.2, 0.75]}, "material": "bark" },
    { "name": "trunks",              "when": {"sway": true, "dy": [1.5, null], "wide": [null, 1.2], "thin": [0.2, null], "tris": [null, 30]}, "material": "bark" },
    { "name": "cloth in the wind",   "when": {"sway": true}, "material": "cloth" },
    { "name": "lamps",               "when": {"flat": [0.6, null], "val": [0.9, null], "hue": [30, 70], "sat": [0.2, 0.75], "size": [null, 1.6], "planar": false}, "material": "lamp" },
    { "name": "brick",               "when": {"hue": [345, 28], "sat": [0.3, 0.8], "val": [0.45, 0.92], "size": [1.2, null], "flat": [null, 0.5]}, "material": "brick" },
    { "name": "big pale walls",      "when": {"sat": [null, 0.16], "val": [0.72, null], "side": [0.5, null], "size": [5.0, null], "flat": [null, 0.6]}, "material": "ashlar" },
    { "name": "roofs",               "when": {"sat": [null, 0.2], "val": [0.6, null], "up": [0.45, null], "wide": [2.5, null], "dy": [null, 0.7], "y": [3.0, null], "flat": [null, 0.6]}, "material": "concrete" },
    { "name": "pale floors",         "when": {"sat": [null, 0.16], "val": [0.72, null], "up": [0.45, null], "wide": [2.5, null], "dy": [null, 0.7], "flat": [null, 0.6]}, "material": "paving" },
    { "name": "pale stone",          "when": {"sat": [null, 0.16], "val": [0.72, null], "flat": [null, 0.6]}, "material": "marble" },
    { "name": "lawn",                "when": {"hue": [70, 170], "sat": [0.2, null], "up": [0.6, null], "wide": [1.5, null], "dy": [null, 0.6]}, "material": "grass" },
    { "name": "lawn discs",          "when": {"hue": [70, 170], "sat": [0.2, null], "up": [0.4, null], "wide": [1.5, null], "dy": [null, 0.6], "y": [null, 1.5]}, "material": "grass" },
    { "name": "still shrubs",        "when": {"hue": [70, 170], "sat": [0.2, 0.62], "val": [0.3, null], "tris": [20, null], "size": [0.5, null], "flat": [null, 0.3], "near": ["#7fb85a", "#3f8a57", "#8cc56c", "#4f9c62", "#6ea884", "#bfe08f", 60]}, "material": "hedge" },
    { "name": "asphalt",             "when": {"near": ["#6d6796", 28], "up": [0.5, null]}, "material": "asphalt" },
    { "name": "window glass",        "when": {"near": ["#a4dbe2", "#3d3766", "#56528f", 30], "thin": [null, 0.6]}, "material": "window" },
    { "name": "brass",               "when": {"near": ["#c9a23f", 36]}, "material": "brass" },
    { "name": "steel",               "when": {"near": ["#8e8fbc", 30]}, "material": "steel" },
    { "name": "patina",              "when": {"near": ["#6fc0a8", "#5ca99a", 26]}, "material": "patina" },
    { "name": "wood",                "when": {"hue": [12, 42], "sat": [0.3, 0.8], "val": [0.3, 0.85], "flat": [null, 0.5]}, "material": "wood" },
    { "name": "big painted walls",   "when": {"chunk": ["city", "trailhead", "switchboard", "postcards", "commons", "studio", "terraces", "greenhouse", "maskgarden", "boneyard", "observatory", "skyharbor"], "val": [0.55, null], "side": [0.5, null], "size": [10.0, null], "area": [250, null], "tris": [null, 40], "flat": [null, 0.6]}, "material": "cladding" },
    { "name": "everything else",     "when": {}, "material": "paint" }
  ]
}
